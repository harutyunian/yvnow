{
  "expo": {
    "name": "Yvnow",
    "slug": "Yvnow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_yvnow.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyBeRfrXKa3XAB8UEUIuTipW97KYb_qYkxE"
      },
      "bundleIdentifier": "com.yvnow.event"
    },
    "android": {
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBeRfrXKa3XAB8UEUIuTipW97KYb_qYkxE"
        }
      },
      "package": "com.yvnow.event"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1c97f0ea-e336-4bef-8d2e-ffdfea0a94c5"
      }
    }
  }
}
